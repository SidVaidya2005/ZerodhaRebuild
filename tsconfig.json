{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    // The `_shared` modules are imported by Deno as well, which requires an
    // explicit `.ts` on every specifier. Next's build never emits from here, so
    // permitting the extension costs nothing and keeps one spelling for both.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./supabase/functions/_shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // The Edge Function *entrypoint* is Deno code: `jsr:` specifiers and the
  // `Deno` global, neither of which this compiler knows. Deno typechecks it on
  // `functions deploy`, so a bad edit still fails before it ships.
  //
  // Only the entrypoint is excluded. `_shared/` stays in, because the app
  // imports those modules through `@shared/*` and they must typecheck against
  // the same rules as everything else — they are the reason there is one copy
  // of the session logic rather than two.
  "exclude": ["node_modules", "supabase/functions/market-tick"]
}
