# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable here is validated at startup — see src/lib/env.ts and src/lib/env.server.ts.

# ── Public: inlined into the browser bundle, safe to expose ──
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Secret: server-only. Never prefix any of these with NEXT_PUBLIC_. ──
# Bypasses RLS. Used only by src/lib/supabase/admin.ts and the market-tick Edge Function.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# Optional second quote provider. The provider chain skips it silently when unset.
TWELVE_DATA_API_KEY=""

# Optional. The *test* Supabase project's connection string, used by tiers 2 and 3.
# Never point this at the dev project — tier 3 commits. Lives in .env.test.local.
TEST_DATABASE_URL=""
