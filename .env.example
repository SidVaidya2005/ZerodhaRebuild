# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable here is validated at startup — see src/lib/env.ts and src/lib/env.server.ts.

# ── Public: inlined into the browser bundle, safe to expose ──
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Secret: server-only. Never prefix any of these with NEXT_PUBLIC_. ──
# Bypasses RLS. Used only by src/lib/supabase/admin.ts and the market-tick Edge Function.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# Optional second quote provider. The provider chain skips it silently when unset.
TWELVE_DATA_API_KEY=""

# The project's connection string, used by tiers 2 and 3. Lives in .env.test.local.
# Use the SESSION-mode pooler (port 5432): tier 3 holds a transaction open across
# statements, which the transaction-mode pooler (6543) cannot express.
TEST_DATABASE_URL=""

# Tier 3 commits into the real database, so it refuses to run unless this is set.
ALLOW_RACE_TESTS=""
